#!/bin/bash
# Make a freshly booted Server ready to hold a site: its database, its Bedrock .env,
# and the ownership Apache needs. Idempotent — it runs on every boot.
#
# Nothing here loads data. Seeding is `make testenv-seed`, kept separate so a Server
# can be reset without a reboot and rebuilt without a reseed.

set -euo pipefail

# shellcheck source=/usr/local/lib/brama-testenv/container-env.sh
. /usr/local/lib/brama-testenv/container-env.sh
load_container_env

# Required, not defaulted: the Dockerfile's ENV is the one place the path is written,
# and a second copy here is a second thing to keep in step.
readonly SITE="${BRAMA_TESTENV_SITE:?BRAMA_TESTENV_SITE is required}"
readonly ROLE="${BRAMA_TESTENV_ROLE:?BRAMA_TESTENV_ROLE is required}"
readonly URL="${BRAMA_TESTENV_URL:?BRAMA_TESTENV_URL is required}"
readonly DB_NAME="${BRAMA_TESTENV_DB_NAME:?BRAMA_TESTENV_DB_NAME is required}"
readonly DB_USER="${BRAMA_TESTENV_DB_USER:?BRAMA_TESTENV_DB_USER is required}"
readonly DB_PASSWORD="${BRAMA_TESTENV_DB_PASSWORD:?BRAMA_TESTENV_DB_PASSWORD is required}"

# The database and its user, over the local unix socket as root — the same way the
# Shim will reach mysqldump, and the reason MariaDB is in this container rather than
# a sibling one.
mariadb --protocol=socket <<SQL
CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\` DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${DB_USER}'@'localhost' IDENTIFIED BY '${DB_PASSWORD}';
GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_USER}'@'localhost';
FLUSH PRIVILEGES;
SQL

# Bedrock reads its credentials from a .env at the project root, which is also where
# the WordPress adapter looks for WP_HOME. Written at boot rather than baked into the
# image so the same image can be both Servers, and so no password is in a layer.
#
# The salts are fixed and obviously fake. A test rig wants the same bytes on every
# boot far more than it wants entropy, and anything that reaches this Server can already
# read the file they are in.
install -o deploy -g www-data -m 0640 /dev/null "${SITE}/.env"
cat > "${SITE}/.env" <<ENV
DB_NAME='${DB_NAME}'
DB_USER='${DB_USER}'
DB_PASSWORD='${DB_PASSWORD}'
DB_HOST='localhost'

WP_ENV='${ROLE}'
WP_HOME='${URL}'
WP_SITEURL="\${WP_HOME}/wp"

AUTH_KEY='brama-testenv-auth-key-not-a-secret'
SECURE_AUTH_KEY='brama-testenv-secure-auth-key-not-a-secret'
LOGGED_IN_KEY='brama-testenv-logged-in-key-not-a-secret'
NONCE_KEY='brama-testenv-nonce-key-not-a-secret'
AUTH_SALT='brama-testenv-auth-salt-not-a-secret'
SECURE_AUTH_SALT='brama-testenv-secure-auth-salt-not-a-secret'
LOGGED_IN_SALT='brama-testenv-logged-in-salt-not-a-secret'
NONCE_SALT='brama-testenv-nonce-salt-not-a-secret'
ENV
chown deploy:www-data "${SITE}/.env"
chmod 0640 "${SITE}/.env"

install -d -o deploy -g www-data -m 2775 "${SITE}/web/app/uploads"
